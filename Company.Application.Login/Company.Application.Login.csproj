<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Prism.Unity" Version="9.0.537" />
    <PackageReference Include="ReactiveUI.SourceGenerators" Version="4.2.0" />
    <PackageReference Include="ReactiveUI.WPF" Version="25.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Company.Application.Share\Company.Application.Share.csproj" />
    <ProjectReference Include="..\Company.Core\Company.Core.csproj" />
    <ProjectReference Include="..\Company.UI\Company.UI.csproj" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy &quot;$(ProjectDir)\bin\Debug\net10.0-windows\$(ProjectName).dll&quot; &quot;$(SolutionDir)\Shell\bin\Debug\net10.0-windows\Modules\&quot; /Y /S &#xD;&#xA;xcopy &quot;$(ProjectDir)\bin\Release\net10.0-windows\$(ProjectName).dll&quot; &quot;$(SolutionDir)\Shell\bin\Release\net10.0-windows\Modules\&quot; /Y /S " />
  </Target>

</Project>
