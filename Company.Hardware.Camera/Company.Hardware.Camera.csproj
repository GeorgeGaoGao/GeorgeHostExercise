<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Company.Core\Company.Core.csproj" />
  </ItemGroup>


	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="xcopy &quot;$(ProjectDir)\bin\Debug\net10.0-windows\$(ProjectName).dll&quot; &quot;$(SolutionDir)\Shell\bin\Debug\net10.0-windows\Modules\&quot; /Y /S &#xD;&#xA;xcopy &quot;$(ProjectDir)\bin\Release\net10.0-windows\$(ProjectName).dll&quot; &quot;$(SolutionDir)\Shell\bin\Release\net10.0-windows\Modules\&quot; /Y /S " />
	</Target>

</Project>
