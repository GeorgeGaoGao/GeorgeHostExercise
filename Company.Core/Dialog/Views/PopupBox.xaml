<Popup x:Class="Company.Core.Dialog.Views.PopupBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Company.Core.Dialog.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" >
    <Grid>
        <Border Name="border" MinHeight="30" Width="400" 
                CornerRadius="8"
                Height="100" Background="Gray">
            <TextBlock TextWrapping="WrapWithOverflow" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Popup}, Path=Message, 
                UpdateSourceTrigger=PropertyChanged}" Foreground="White" FontSize="16" Margin="10">
               
            </TextBlock>
        </Border>
    </Grid>
</Popup>
